<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.CourseSettingsPage"
             Title="Course Settings">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,8" Padding="16" RowSpacing="16">

        <!-- ── EDITOR SECTION ── -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                Padding="14">
            <VerticalStackLayout Spacing="12">

                <Label Text="Edit Grade Range"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                <Picker Title="Select a letter grade"
                        TitleColor="#888888"
                        ItemsSource="{Binding Letters}"
                        SelectedItem="{Binding SelectedLetter}"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                        BackgroundColor="Transparent"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                      IsVisible="{Binding SelectedRow, Converter={StaticResource NotNullConverter}}">
                    <Entry Grid.Column="0"
                           Text="{Binding SelectedRow.Min}"
                           Placeholder="Min %"
                           Keyboard="Numeric"
                           PlaceholderColor="#888888"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                           BackgroundColor="Transparent"/>
                    <Entry Grid.Column="1"
                           Text="{Binding SelectedRow.Max}"
                           Placeholder="Max %"
                           Keyboard="Numeric"
                           PlaceholderColor="#888888"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                           BackgroundColor="Transparent"/>
                </Grid>

                <Grid ColumnDefinitions="*,44,44" ColumnSpacing="8"
                      IsVisible="{Binding SelectedRow, Converter={StaticResource NotNullConverter}}">
                    <Entry Grid.Column="0"
                           Text="{Binding SelectedRow.HexColor}"
                           Placeholder="#RRGGBB"
                           PlaceholderColor="#888888"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                           BackgroundColor="Transparent"/>
                    <BoxView Grid.Column="1"
                             Color="{Binding SelectedRow.ColorPreview}"
                             CornerRadius="6"
                             WidthRequest="36" HeightRequest="36"
                             VerticalOptions="Center"/>
                    <Border Grid.Column="2"
                            BackgroundColor="{Binding SelectedRow.ColorPreview}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            WidthRequest="36" HeightRequest="36"
                            VerticalOptions="Center">
                        <Label Text="{Binding SelectedLetter}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding SelectedRow, Converter={StaticResource NotNullConverter}}">
                    <Label Text="Presets"
                           FontSize="11" TextColor="#888888"/>
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                        <FlexLayout.Resources>
                            <Style x:Key="SwatchStyle" TargetType="Border">
                                <Setter Property="StrokeThickness" Value="0"/>
                                <Setter Property="StrokeShape" Value="RoundRectangle 6"/>
                                <Setter Property="WidthRequest" Value="32"/>
                                <Setter Property="HeightRequest" Value="32"/>
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </FlexLayout.Resources>

                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#2E7D32"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#2E7D32"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#388E3C"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#388E3C"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#1565C0"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#1565C0"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#1976D2"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#1976D2"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#00695C"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#00695C"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#F57F17"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#F57F17"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#E65100"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#E65100"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#BF360C"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#BF360C"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#C62828"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#C62828"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#6A1B9A"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#6A1B9A"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#4527A0"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#4527A0"/></Border.GestureRecognizers></Border>
                        <Border Style="{StaticResource SwatchStyle}" BackgroundColor="#37474F"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PresetColorTapped" CommandParameter="#37474F"/></Border.GestureRecognizers></Border>
                    </FlexLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

<!-- ── SEMESTER DATES ── -->
<Border Grid.Row="1"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
        StrokeShape="RoundRectangle 12"
        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
        Padding="14">
    <VerticalStackLayout Spacing="12">

        <Label Text="Semester Dates"
               FontSize="14" FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
            <Label Grid.Row="0" Grid.Column="0"
                   Text="Start Date"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                   VerticalOptions="Center"/>
            <DatePicker Grid.Row="0" Grid.Column="1"
                        Date="{Binding StartDate}"
                        Format="MMM dd, yyyy"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                        BackgroundColor="Transparent"/>

            <Label Grid.Row="1" Grid.Column="0"
                   Text="End Date"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                   VerticalOptions="Center"/>
            <DatePicker Grid.Row="1" Grid.Column="1"
                        Date="{Binding EndDate}"
                        Format="MMM dd, yyyy"
                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                        BackgroundColor="Transparent"/>
        </Grid>

    </VerticalStackLayout>
</Border>

        <!-- Save button -->
        <Button Grid.Row="2"
                Text="Save Grade Scale"
                Clicked="SaveClicked"
                BackgroundColor="#1565C0"
                TextColor="White"
                CornerRadius="8"/>

        <!-- ── SUMMARY LIST ── -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="4">
                <Label Text="Current Scale"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#888888"
                       Margin="0,0,0,4"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding GradeRows}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8" Padding="0,2">
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding ColorPreview}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="4,3">
                                    <Label Text="{Binding Letter}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="{Binding RangeDisplay}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding HexColor}"
                                       FontSize="11"
                                       TextColor="#888888"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>