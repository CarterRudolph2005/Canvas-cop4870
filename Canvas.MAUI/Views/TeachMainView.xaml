<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.TeacherMainView"
             Title="My Courses">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Log Out" Clicked="BackClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Action Buttons -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="8"
              Padding="16,12">
            <Button Grid.Column="0"
                    Text="+ Add Course"
                    Clicked="ToggleAddCourseClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Start"/>
            <Button Grid.Column="1"
                    Text="⚙ Filter"
                    Clicked="ToggleFilterClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Start"/>
        </Grid>

        <!-- Add Course Form -->
        <Border Grid.Row="1"
                IsVisible="{Binding ShowAddCourseForm}"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                Padding="14"
                Margin="16,0">
            <VerticalStackLayout Spacing="10">
                <Label Text="New Course"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                <Entry Placeholder="Course Name"
                       Text="{Binding NewCourseName}"
                       PlaceholderColor="#888888"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                       BackgroundColor="Transparent"/>
                <Entry Placeholder="Course Code (e.g. COP4020)"
                       Text="{Binding NewCourseCode}"
                       PlaceholderColor="#888888"
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                       BackgroundColor="Transparent"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Year"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeShape="RoundRectangle 8"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding NewCourseYears}"
                                    SelectedItem="{Binding NewCourseSelectedYear}"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Semester"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeShape="RoundRectangle 8"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding NewCourseSemesters}"
                                    SelectedItem="{Binding NewCourseSelectedSemester}"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Add"
                            Clicked="AddCourseClicked"
                            BackgroundColor="#1565C0"
                            TextColor="White"
                            CornerRadius="8"/>
                    <Button Grid.Column="1"
                            Text="Cancel"
                            Clicked="ToggleAddCourseClicked"
                            BackgroundColor="#888888"
                            TextColor="White"
                            CornerRadius="8"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowFilterCoursesForm}"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                Padding="16">
            <VerticalStackLayout Spacing="12">

                <Label Text="FILTER &amp; SORT"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#90CAF9"
                       CharacterSpacing="1.5"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Year"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="Transparent"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding AvailableYears}"
                                    SelectedItem="{Binding SelectedYear}"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    BackgroundColor="Transparent"
                                    TitleColor="#888888"
                                    Title="All Years"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Semester"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="Transparent"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding AvailableSemesters}"
                                    SelectedItem="{Binding SelectedSemester}"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    BackgroundColor="Transparent"
                                    TitleColor="#888888"
                                    Title="All Semesters"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Sort By"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="Transparent"
                            Padding="4,0">
                        <Picker ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SelectedSortOption}"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Clear Filters"
                        Clicked="ClearFiltersClicked"
                        BackgroundColor="Transparent"
                        TextColor="#EF5350"
                        FontSize="13"
                        HorizontalOptions="End"/>

            </VerticalStackLayout>
        </Border>

        <!-- Course Grid -->
        <ScrollView Grid.Row="3">
            <CollectionView ItemsSource="{Binding FilteredCourses}"
                            Margin="16"
                            SelectionMode="Single"
                            SelectionChanged="CourseTapped">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#42A5F5"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,4"
                                        Radius="8"
                                        Opacity="0.15"/>
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto,*">
                                <BoxView Grid.Row="0"
                                         BackgroundColor="#1565C0"
                                         HeightRequest="48"/>
                                <Label Grid.Row="0"
                                       Text="{Binding FullCourseHeader}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       CharacterSpacing="1.5"
                                       VerticalOptions="Center"
                                       Margin="14,0"/>
                                <Label Grid.Row="0"
                                       Text="{Binding SemesterTaught}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       CharacterSpacing="1.5"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       Margin="14,0"/>
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="WordWrap"
                                       Margin="14,12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Margin="0,60">
                        <Label Text="No courses found"
                               FontSize="16"
                               TextColor="#AAAAAA"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </ScrollView>

    </Grid>
</ContentPage>