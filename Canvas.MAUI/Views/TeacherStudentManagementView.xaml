<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.TeacherStudentManagementView"
             Title="Student Management Menu"
             NavigatedTo="ContentPage_NavigatedTo">

    <Grid RowDefinitions="Auto, *, Auto" Padding="30">

        <Label Grid.Row="0" 
               Text="Welcome to the student management menu!"
               FontSize="32"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="#FF660080"
               Margin="0,0,0,10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Students}"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionMode="Single"
                        Margin="0,0,0,10">
            
            <CollectionView.Header>
                <Grid Padding="10, 20, 10, 10"> 
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Text="STUDENT INFO" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           Grid.Column="0" />
                           
                    <Label Text="ACTIONS" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="End" 
                           Grid.Column="1" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/> 
                            <ColumnDefinition Width="2*"/> 
                        </Grid.ColumnDefinitions>

                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="{Binding Id}" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="12" HorizontalOptions="End">
                            <Button Text="Edit" Scale="0.9" />
                            <Button Text="Delete" Scale="0.9" BackgroundColor="Red"/>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Add Student"
                Clicked="AddStudentClicked"
                HeightRequest="60"
                BackgroundColor="#FF008053"
                Margin="0,10,0,20" />

    </Grid>
</ContentPage>