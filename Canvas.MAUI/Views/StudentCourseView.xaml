<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.StudentCourseView"
             Title="{Binding Name}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Log Out" Clicked="BackClicked"/>
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Margin="16">

            <!-- Course Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1565C0"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Code}"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#90CAF9"
                        CharacterSpacing="1.5"/>
                    <Label Text="{Binding Name}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"/>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="0" Margin="0,8,0,0">
                        <Label Text="{Binding LetterGrade}"
                            FontSize="48"
                            FontAttributes="Bold"
                            TextColor="{Binding LetterGradeColor}"
                            HorizontalOptions="Center"/>
                        <Label Text="{Binding GradePercentage, StringFormat='{0:F2}%'}"
                            FontSize="16"
                            TextColor="White"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#8F00FF"
                    Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ANNOUNCEMENTS"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White"
                        CharacterSpacing="1.5"
                        Margin="0,0,0,5"/>

                    <Label Text="No announcements yet"
                        TextColor="#E1BEE7"
                        HorizontalOptions="Center"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" 
                                        Binding="{Binding Announcements.Count}" 
                                        Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Announcements}"
                                        Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#FFFFFF" 
                                        Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        
                                        <Label Text="{Binding PostedDate, StringFormat='{0:MMMM dd, yyyy}'}"
                                            FontSize="10"
                                            TextColor="#757575"
                                            FontAttributes="Italic" />

                                        <Label Text="{Binding Title}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1A1A1A" />

                                        <Label Text="{Binding Body}"
                                            FontSize="13"
                                            TextColor="#444444"
                                            LineBreakMode="WordWrap" />
                                        
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            
            <!-- Assignments -->
            <VerticalStackLayout IsVisible="{Binding HasAssignments}">
                <Label Text="Assignments"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>
                <CollectionView ItemsSource="{Binding Assignments}"
                                SelectionMode="Single"
                                SelectionChanged="AssignmentTapped">
                    <CollectionView.EmptyView>
                        <Label Text="No assignments yet"
                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                            HorizontalOptions="Center"
                            Margin="0,8"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                        <Border IsVisible="{Binding Assignment.IsQuiz}"
                                                BackgroundColor="#E65100"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6,2"
                                                HorizontalOptions="Start">
                                            <Label Text="🧩 Quiz" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <Label Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                        <Label Text="{Binding AvailablePoints, StringFormat='Points: {0}'}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                        <Border IsVisible="{Binding HasGroup}"
                                                BackgroundColor="#6A1B9A"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6,2"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding GroupName}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="White"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                        Text="{Binding DueDate, StringFormat='Due {0:MMM dd}'}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#42A5F5"
                                        VerticalOptions="Start"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Modules -->
            <Label Text="Modules"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}"
                                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="0"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                            <VerticalStackLayout Spacing="0">

                                <!-- Tappable header -->
                                <Grid ColumnDefinitions="*,Auto"
                                    Padding="14,12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ModuleHeaderTapped"
                                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                        Text="{Binding ModuleName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                        VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                        Text="▶"
                                        FontSize="12"
                                        TextColor="#42A5F5"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                        Binding="{Binding IsExpanded}"
                                                        Value="True">
                                                <Setter Property="Text" Value="▼"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <!-- Divider -->
                                <BoxView HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                        IsVisible="{Binding IsExpanded}"/>

                                <!-- Expandable content -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ModuleContents}"
                                                    Spacing="0"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Padding="10,8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="0,4"
                                                    Padding="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                Binding="{Binding ContentType}"
                                                                Value="Assignment">
                                                        <Setter Property="BackgroundColor" Value="#1565C0"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                Binding="{Binding ContentType}"
                                                                Value="File">
                                                        <Setter Property="BackgroundColor" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                Binding="{Binding ContentType}"
                                                                Value="Page">
                                                        <Setter Property="BackgroundColor" Value="#00695C"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Grid ColumnDefinitions="Auto,*"
                                                    Padding="12,10">
                                                    <Label Grid.Column="0"
                                                        FontSize="14"
                                                        VerticalOptions="Center"
                                                        Margin="0,0,10,0">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="Assignment">
                                                                <Setter Property="Text" Value="📝"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="File">
                                                                <Setter Property="Text" Value="📄"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="Page">
                                                                <Setter Property="Text" Value="📖"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="ModuleContentTapped"
                                                                                CommandParameter="{Binding .}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>