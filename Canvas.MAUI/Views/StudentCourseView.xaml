<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.StudentCourseView"
             Title="{Binding Name}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Clicked="BackClicked"/>
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Margin="16">

            <!-- Course Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1565C0"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Code}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#90CAF9"
                           CharacterSpacing="1.5"/>
                    <Label Text="{Binding Name}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <!-- Assignments -->
            <Label Text="Assignments"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assignments}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                    <Label Text="{Binding AvailablePoints, StringFormat='Points: {0}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding DueDate, StringFormat='Due {0:MMM dd}'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#42A5F5"
                                       VerticalOptions="Start"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Modules -->
            <Label Text="Modules"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                            <VerticalStackLayout Spacing="8">

                                <!-- Tappable header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ModuleHeaderTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                           Text="{Binding ModuleName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Grid.Column="1"
                                           Text="▶"
                                           FontSize="12"
                                           TextColor="#42A5F5"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <!-- Collapsible content -->
                                <VerticalStackLayout Spacing="4" IsVisible="False"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>