<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.StudentCourseView"
             Title="{Binding Name}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Log Out" Clicked="BackClicked"/>
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Margin="16">

            <!-- Course Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1565C0"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Code}"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#90CAF9"
                        CharacterSpacing="1.5"/>
                    <Label Text="{Binding Name}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"/>
                    <Label Text="{Binding GradePercentage, StringFormat='{0}%'}"
                        FontSize="48"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Border>
            
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#8F00FF"
                    Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ANNOUNCEMENTS"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White"
                        CharacterSpacing="1.5"
                        Margin="0,0,0,5"/>

                    <Label Text="No announcements yet"
                        TextColor="#E1BEE7"
                        HorizontalOptions="Center"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" 
                                        Binding="{Binding Announcements.Count}" 
                                        Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Announcements}"
                                        Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#FFFFFF" 
                                        Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        
                                        <Label Text="{Binding PostedDate, StringFormat='{0:MMMM dd, yyyy}'}"
                                            FontSize="10"
                                            TextColor="#757575"
                                            FontAttributes="Italic" />

                                        <Label Text="{Binding Title}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1A1A1A" />

                                        <Label Text="{Binding Body}"
                                            FontSize="13"
                                            TextColor="#444444"
                                            LineBreakMode="WordWrap" />
                                        
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            
            <!-- Assignments -->
            <Label Text="Assignments"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>

            <CollectionView ItemsSource="{Binding Assignments}"
                            SelectionMode="Single"
                            SelectionChanged="AssignmentTapped">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Text="{Binding Description}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                    <Label Text="{Binding AvailablePoints, StringFormat='Points: {0}'}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                    Text="{Binding DueDate, StringFormat='Due {0:MMM dd}'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#42A5F5"
                                    VerticalOptions="Start"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Modules -->
            <Label Text="Modules"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E0E0E0}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                            <VerticalStackLayout Spacing="8">

                                <!-- Tappable header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ModuleHeaderTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                           Text="{Binding ModuleName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Grid.Column="1"
                                           Text="▶"
                                           FontSize="12"
                                           TextColor="#42A5F5"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <!-- Collapsible content -->
                                <VerticalStackLayout Spacing="4" IsVisible="False"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>