<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.StudentMainView"
             Title="Student Main View">
    
    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

    <Label Text="Welcome to the student menu!"
        FontSize="32"
        HorizontalOptions="Center"
        TextColor="#FF660080" />

    <Button Text="Leave Menu"
            Clicked="LeaveMenuClicked"
            HeightRequest="60"
            BackgroundColor="#FF008053" />

    </VerticalStackLayout>

</ContentPage>