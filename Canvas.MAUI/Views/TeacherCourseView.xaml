<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.TeacherCourseView"
             Title="{Binding Name}"
             NavigatedTo="OnNavigatedTo">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Log Out" Clicked="BackClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Course Header -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="#1565C0"
                Padding="16,12">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Code}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#90CAF9"
                       CharacterSpacing="1.5"/>
                <Label Text="{Binding Name}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </VerticalStackLayout>
        </Border>

        <!-- Tab Bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
            <Button Grid.Column="0" Text="Home"
                    x:Name="HomeTabBtn"
                    Clicked="AnnouncementsTabClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    FontSize="12" CornerRadius="0"/>
            <Button Grid.Column="1" Text="Modules"
                    x:Name="ModulesTabBtn"
                    Clicked="ModulesTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="#888888"
                    FontSize="12" CornerRadius="0"/>
            <Button Grid.Column="2" Text="Assignments"
                    x:Name="AssignmentsTabBtn"
                    Clicked="AssignmentsTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="#888888"
                    FontSize="12" CornerRadius="0"/>
            <Button Grid.Column="3" Text="Roster"
                    x:Name="RosterTabBtn"
                    Clicked="RosterTabClicked"
                    BackgroundColor="Transparent"
                    TextColor="#888888"
                    FontSize="12" CornerRadius="0"/>
        </Grid>

        <!-- Tab Content -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12" Margin="16">

                <!-- ── ANNOUNCEMENTS TAB ── -->
                <VerticalStackLayout IsVisible="{Binding IsAnnouncementsTab}" Spacing="12">

                    <Button Text="+ New Announcement"
                            Clicked="ToggleAnnouncementFormClicked"
                            BackgroundColor="#1565C0"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="Start"/>

                    <Border IsVisible="{Binding ShowAnnouncementForm}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="New Announcement"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                            <Entry Placeholder="Title"
                                   Text="{Binding NewAnnouncementTitle}"
                                   PlaceholderColor="#888888"
                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                   BackgroundColor="Transparent"/>
                            <Editor Placeholder="Body"
                                    Text="{Binding NewAnnouncementBody}"
                                    PlaceholderColor="#888888"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    BackgroundColor="Transparent"
                                    HeightRequest="100"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="Post"
                                        Clicked="SubmitAnnouncementClicked"
                                        BackgroundColor="#1565C0" TextColor="White" CornerRadius="8"/>
                                <Button Grid.Column="1" Text="Cancel"
                                        Clicked="ToggleAnnouncementFormClicked"
                                        BackgroundColor="#888888" TextColor="White" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Announcements}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,44,44">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="1" Text="✏️"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="EditAnnouncementClicked"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="2" Text="🗑"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="DeleteAnnouncementClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                        <Label Text="{Binding Body}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                        <Label Text="{Binding PostedDate, StringFormat='Posted {0:MMM dd, yyyy}'}"
                                               FontSize="11" TextColor="#888888"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ── MODULES TAB ── -->
                <VerticalStackLayout IsVisible="{Binding IsModulesTab}" Spacing="12">

                    <Button Text="+ New Module"
                            Clicked="ToggleModuleFormClicked"
                            BackgroundColor="#1565C0" TextColor="White"
                            CornerRadius="8" HorizontalOptions="Start"/>

                    <Border IsVisible="{Binding ShowModuleForm}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="New Module"
                                FontSize="14" FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                            <Entry Placeholder="Module name"
                                Text="{Binding NewModuleName}"
                                PlaceholderColor="#888888"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                BackgroundColor="Transparent"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="Add"
                                        Clicked="SubmitModuleClicked"
                                        BackgroundColor="#1565C0" TextColor="White" CornerRadius="8"/>
                                <Button Grid.Column="1" Text="Cancel"
                                        Clicked="ToggleModuleFormClicked"
                                        BackgroundColor="#888888" TextColor="White" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Modules List -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- Module Header Row -->
                                        <Grid ColumnDefinitions="*,44,44,44,44"
                                            Padding="14,12">
                                            <Grid Grid.Column="0"
                                                ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0"
                                                    Text="▶"
                                                    FontSize="12"
                                                    TextColor="#42A5F5"
                                                    VerticalOptions="Center"
                                                    Margin="0,0,8,0">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                    Binding="{Binding IsExpanded}"
                                                                    Value="True">
                                                            <Setter Property="Text" Value="▼"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ModuleHeaderTapped"
                                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Grid.Column="1"
                                                    Text="{Binding ModuleName}"
                                                    FontSize="14" FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                                    VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ModuleHeaderTapped"
                                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>
                                            <Button Grid.Column="1" Text="+"
                                                    FontSize="14" BackgroundColor="Transparent"
                                                    TextColor="#42A5F5"
                                                    Clicked="AddModuleContentClicked"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="2" Text="✏️"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="EditModuleClicked"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="3" Text="🗑"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="DeleteModuleClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>

                                        <BoxView HeightRequest="1"
                                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                                IsVisible="{Binding IsExpanded}"/>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ModuleContents}"
                                                            Spacing="0"
                                                            IsVisible="{Binding IsExpanded}"
                                                            Padding="10,8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Margin="0,4"
                                                            Padding="0">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="Assignment">
                                                                <Setter Property="BackgroundColor" Value="#1565C0"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="File">
                                                                <Setter Property="BackgroundColor" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border"
                                                                        Binding="{Binding ContentType}"
                                                                        Value="Page">
                                                                <Setter Property="BackgroundColor" Value="#00695C"/>
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Grid ColumnDefinitions="Auto,*,44"
                                                            Padding="12,10">
                                                            <Label Grid.Column="0"
                                                                FontSize="14"
                                                                VerticalOptions="Center"
                                                                Margin="0,0,10,0">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label"
                                                                                Binding="{Binding ContentType}"
                                                                                Value="Assignment">
                                                                        <Setter Property="Text" Value="📝"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Label"
                                                                                Binding="{Binding ContentType}"
                                                                                Value="File">
                                                                        <Setter Property="Text" Value="📄"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Label"
                                                                                Binding="{Binding ContentType}"
                                                                                Value="Page">
                                                                        <Setter Property="Text" Value="📖"/>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                            <Label Grid.Column="1"
                                                                Text="{Binding Name}"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="White"
                                                                VerticalOptions="Center">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="ModuleContentTapped"
                                                                                        CommandParameter="{Binding .}"/>
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <Button Grid.Column="2"
                                                                    Text="🗑"
                                                                    FontSize="11"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="White"
                                                                    Clicked="DeleteModuleContentClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    VerticalOptions="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ── ASSIGNMENTS TAB ── -->
                <VerticalStackLayout IsVisible="{Binding IsAssignmentsTab}" Spacing="12">

                    <!-- Action Buttons  + New Quiz added here -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="+ New Assignment"
                                Clicked="AddAssignmentClicked"
                                BackgroundColor="#1565C0" TextColor="White"
                                CornerRadius="8"/>
                        <Button Text="+ New Quiz"
                                Clicked="AddQuizClicked"
                                BackgroundColor="#E65100" TextColor="White"
                                CornerRadius="8"/>
                        <Button Text="+ New Group"
                                Clicked="AddGroupClicked"
                                BackgroundColor="#6A1B9A" TextColor="White"
                                CornerRadius="8"/>
                    </HorizontalStackLayout>

                    <!-- Assignment Groups -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AssignmentGroups}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="2"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#2A1A2E}"
                                        Stroke="#6A1B9A">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Group Header -->
                                        <Grid ColumnDefinitions="*,Auto,44,44">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                    FontSize="15" FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                <Label Text="{Binding TotalPoints, StringFormat='Group Total: {0} pts'}"
                                                    FontSize="12" TextColor="#888888"/>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="+ Add Assignment"
                                                    FontSize="11"
                                                    BackgroundColor="#6A1B9A" TextColor="White"
                                                    CornerRadius="6" Padding="8,4"
                                                    Clicked="AddAssignmentToGroupClicked"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Center"/>
                                            <Button Grid.Column="2" Text="✏️"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="EditGroupClicked"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Start"/>
                                            <Button Grid.Column="3" Text="🗑"
                                                    FontSize="12" BackgroundColor="Transparent"
                                                    Clicked="DeleteGroupClicked"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Start"/>
                                        </Grid>

                                        <!-- Grouped assignment cards: quiz badge + Edit Quiz added -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding GroupAssignments}" Spacing="6" Margin="8,0,0,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="14"
                                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,44,44,44">
                                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                                <Label Text="{Binding Name}"
                                                                    FontSize="14" FontAttributes="Bold"
                                                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                                <Border IsVisible="{Binding IsQuiz}"
                                                                        BackgroundColor="#E65100"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 4"
                                                                        Padding="6,2"
                                                                        HorizontalOptions="Start">
                                                                    <Label Text="🧩 Quiz" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                                                </Border>
                                                                <Label Text="{Binding Description}"
                                                                    FontSize="12"
                                                                    TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                                                <Label Text="{Binding AvailablePoints, StringFormat='Points: {0}'}"
                                                                    FontSize="12" TextColor="#888888"/>
                                                                <Label Text="{Binding DueDate, StringFormat='Due {0:MMM dd}'}"
                                                                    FontSize="12" FontAttributes="Bold" TextColor="#42A5F5"/>
                                                            </VerticalStackLayout>

                                                            <Border Grid.Column="1"
                                                                    BackgroundColor="#2E7D32"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    StrokeThickness="0"
                                                                    Padding="10,6"
                                                                    VerticalOptions="Center"
                                                                    Margin="0,0,8,0">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="GradeAssignmentClicked"
                                                                                        CommandParameter="{Binding .}"/>
                                                                </Border.GestureRecognizers>
                                                                <Label Text="Grade" FontSize="12" FontAttributes="Bold"
                                                                    TextColor="White"
                                                                    VerticalOptions="Center" HorizontalOptions="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="2"
                                                                    IsVisible="{Binding IsQuiz}"
                                                                    BackgroundColor="#E65100"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    StrokeThickness="0"
                                                                    Padding="10,6"
                                                                    VerticalOptions="Center"
                                                                    Margin="0,0,8,0">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="EditQuizClicked"
                                                                                        CommandParameter="{Binding .}"/>
                                                                </Border.GestureRecognizers>
                                                                <Label Text="Edit Quiz" FontSize="12" FontAttributes="Bold"
                                                                    TextColor="White"
                                                                    VerticalOptions="Center" HorizontalOptions="Center"/>
                                                            </Border>

                                                            <Button Grid.Column="3" Text="⎘"
                                                                    FontSize="14" BackgroundColor="Transparent"
                                                                    TextColor="#42A5F5"
                                                                    Clicked="CopyAssignmentClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    VerticalOptions="Start"/>
                                                            <Button Grid.Column="4" Text="✏️"
                                                                    FontSize="12" BackgroundColor="Transparent"
                                                                    Clicked="EditAssignmentClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    VerticalOptions="Start"/>
                                                            <Button Grid.Column="5" Text="🗑"
                                                                    FontSize="12" BackgroundColor="Transparent"
                                                                    Clicked="DeleteAssignmentClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    VerticalOptions="Start"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Label Text="No assignments in this group yet."
                                            FontSize="12" TextColor="#888888"
                                            Margin="8,0,0,0"
                                            IsVisible="{Binding IsEmpty}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Ungrouped Assignments: quiz badge + Edit Quiz added -->
                    <Label Text="Ungrouped Assignments"
                        FontSize="13" FontAttributes="Bold"
                        TextColor="#888888"
                        IsVisible="{Binding HasUngroupedAssignments}"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UngroupedAssignments}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,44,44,44">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                FontSize="14" FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                            <Border IsVisible="{Binding IsQuiz}"
                                                    BackgroundColor="#E65100"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 4"
                                                    Padding="6,2"
                                                    HorizontalOptions="Start">
                                                <Label Text="🧩 Quiz" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                            </Border>
                                            <Label Text="{Binding Description}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"/>
                                            <Label Text="{Binding AvailablePoints, StringFormat='Points: {0}'}"
                                                FontSize="12" TextColor="#888888"/>
                                            <Label Text="{Binding DueDate, StringFormat='Due {0:MMM dd}'}"
                                                FontSize="12" FontAttributes="Bold" TextColor="#42A5F5"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#2E7D32"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                VerticalOptions="Center"
                                                Margin="0,0,8,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="GradeAssignmentClicked"
                                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="Grade" FontSize="12" FontAttributes="Bold"
                                                TextColor="White"
                                                VerticalOptions="Center" HorizontalOptions="Center"/>
                                        </Border>

                                        <Border Grid.Column="2"
                                                IsVisible="{Binding IsQuiz}"
                                                BackgroundColor="#E65100"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                VerticalOptions="Center"
                                                Margin="0,0,8,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="EditQuizClicked"
                                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="Edit Quiz" FontSize="12" FontAttributes="Bold"
                                                TextColor="White"
                                                VerticalOptions="Center" HorizontalOptions="Center"/>
                                        </Border>

                                        <Button Grid.Column="3" Text="⎘"
                                                FontSize="14" BackgroundColor="Transparent"
                                                TextColor="#42A5F5"
                                                Clicked="CopyAssignmentClicked"
                                                CommandParameter="{Binding .}"
                                                VerticalOptions="Start"/>
                                        <Button Grid.Column="4" Text="✏️"
                                                FontSize="12" BackgroundColor="Transparent"
                                                Clicked="EditAssignmentClicked"
                                                CommandParameter="{Binding .}"
                                                VerticalOptions="Start"/>
                                        <Button Grid.Column="5" Text="🗑"
                                                FontSize="12" BackgroundColor="Transparent"
                                                Clicked="DeleteAssignmentClicked"
                                                CommandParameter="{Binding .}"
                                                VerticalOptions="Start"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ROSTER TAB -->
                <VerticalStackLayout IsVisible="{Binding IsRosterTab}" Spacing="12">

                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="+ Enroll Student"
                                Clicked="ToggleEnrollFormClicked"
                                BackgroundColor="#1565C0" TextColor="White"
                                CornerRadius="8"/>
                        <Button Grid.Column="1"
                                Text="⬆ Import CSV"
                                Clicked="ImportRosterClicked"
                                BackgroundColor="#2E7D32" TextColor="White"
                                CornerRadius="8"/>
                        <Button Grid.Column="2"
                                Text="⬇ Export CSV"
                                Clicked="ExportRosterClicked"
                                BackgroundColor="#00695C" TextColor="White"
                                CornerRadius="8"/>
                    </Grid>

                    <Border IsVisible="{Binding ShowEnrollForm}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Enroll a Student"
                                FontSize="14" FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                            <Entry Placeholder="Enter student code (e.g. cr24)"
                                Text="{Binding EnrollStudentCode}"
                                PlaceholderColor="#888888"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                BackgroundColor="Transparent"/>
                            <Label Text="{Binding EnrollError}"
                                TextColor="#EF5350"
                                FontSize="12"
                                IsVisible="{Binding HasEnrollError}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="Enroll"
                                        Clicked="EnrollStudentClicked"
                                        BackgroundColor="#2E7D32" TextColor="White" CornerRadius="8"/>
                                <Button Grid.Column="1" Text="Cancel"
                                        Clicked="ToggleEnrollFormClicked"
                                        BackgroundColor="#888888" TextColor="White" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Roster}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}">
                                    <Grid ColumnDefinitions="*,44">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                            <Label Text="{Binding Code}"
                                                   FontSize="12" TextColor="#888888"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="✕"
                                                FontSize="12" TextColor="#EF5350"
                                                BackgroundColor="Transparent"
                                                Clicked="UnenrollStudentClicked"
                                                CommandParameter="{Binding .}"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
