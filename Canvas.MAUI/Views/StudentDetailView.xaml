<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.Views.StudentDetailView"
             Title="Student Details"
             x:Name="ThisPage"
            NavigatedTo="ContentPage_NavigatedTo">

        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Name" FontAttributes="Bold"/>
            <Entry Text="{Binding Name}" Placeholder="Enter student name"/>

            <Label Text="Code" FontAttributes="Bold"/>
            <Entry Text="{Binding Code}" Placeholder="Enter student code"/>

            <Label Text="Classification" FontAttributes="Bold"/>
            <Picker 
                Title="Select Classification"
                ItemsSource="{Binding Source={x:Reference ThisPage}, Path=ClassificationOptions}"
                SelectedItem="{Binding Classification}" />

            <HorizontalStackLayout Spacing="12" Margin="0,24,0,0">
                <Button 
                    Text="Save" 
                    Clicked="SaveAndExitClicked"
                    HorizontalOptions="FillAndExpand"/>

                <Button 
                    Text="Cancel" 
                    Clicked="ExitClicked"
                    BackgroundColor="LightGray"
                    HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
</ContentPage>