<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Canvas.MAUI.MainPage">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="Welcome to Canvas"
            FontSize="32"
            HorizontalOptions="Center"
            TextColor="#FF660080" />

        <Button Text="I am a Teacher"
                Clicked="OnTeacherClicked"
                HeightRequest="60"
                BackgroundColor="#FF008053" />

        <Button Text="I am a Student"
                Clicked="OnStudentClicked"
                HeightRequest="60"
                BackgroundColor="#FFCE12C5" />

    </VerticalStackLayout>

</ContentPage>
